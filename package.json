{
  "name": "lsmc-ss1-placement-system",
  "version": "1.16.0",
  "description": "SS1 Department Placement Test System — Lagos State Senior Model College, Ojo",
  "main": "electron/main.js",
  "author": "LSMC Ojo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "ng.edu.lsmcojo.ss1placement",
    "productName": "SS1 Placement System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "LSMC-SS1-Placement-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SS1 Placement System"
    },
    "portable": {
      "artifactName": "LSMC-SS1-Placement-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
